<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for page in ("home", "privacy") %}
{% for lang in ("it", "en") %}
  <url>
    <loc>{{ site_url }}{{ content[lang].paths[page] }}</loc>
    <xhtml:link rel="alternate" hreflang="it" href="{{ site_url }}{{ content.it.paths[page] }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site_url }}{{ content.en.paths[page] }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site_url }}{{ content.it.paths[page] }}"/>
  </url>
{% endfor %}
{% endfor %}
</urlset>
