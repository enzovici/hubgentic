# Caddy sites for hubgentic on the VPS (appended to /etc/caddy/Caddyfile).
# The app runs as systemd unit `hubgentic` on 127.0.0.1:8010; the static site
# is uploaded to /var/www/hubgentic-site by `make deploy-site`.

# hubgentic web app -> systemd unit hubgentic.service on 127.0.0.1:8010
app.hubgentic.ai {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8010
	log {
		output file /var/log/caddy/hubgentic.log
	}
}

# Marketing site. No access log: the privacy notice promises minimal logging.
www.hubgentic.ai {
	encode zstd gzip

	# Contact form posts land in the app's leads table (same origin, so the
	# app's cross-site check passes).
	handle /lead {
		reverse_proxy 127.0.0.1:8010
	}

	handle {
		root * /var/www/hubgentic-site
		header {
			Strict-Transport-Security "max-age=31536000"
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
			-Server
		}
		@versioned path /assets/site.css /assets/site.js
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		@static path /assets/*
		header @static Cache-Control "public, max-age=604800"

		# Paths from the previous (Lovable) site.
		redir /whitepaper / permanent
		redir /work-with-us "/#contatti" permanent
		redir /admin / permanent
		redir /auth / permanent

		file_server
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /var/www/hubgentic-site
			rewrite * /404.html
			file_server
		}
	}
}

hubgentic.ai {
	redir https://www.hubgentic.ai{uri} permanent
}
