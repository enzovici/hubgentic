# Lead email alerts. On the VPS: /etc/hubgentic/hubgentic.env (root:root, mode 600),
# then `sudo systemctl restart hubgentic`. Alerts stay off while HOST is empty.
#
# Gmail example: create an app password at https://myaccount.google.com/apppasswords
# (needs 2-step verification) and use it as the password below.
HUBGENTIC_SMTP_HOST=
HUBGENTIC_SMTP_PORT=587
HUBGENTIC_SMTP_USER=
HUBGENTIC_SMTP_PASSWORD=
# Sender address (defaults to the SMTP user) and comma-separated recipients
# (default: HUBGENTIC_ADMIN_EMAILS).
HUBGENTIC_SMTP_FROM=
HUBGENTIC_LEAD_NOTIFY=
