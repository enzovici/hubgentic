---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, HAS_FAVICON } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** Section anchors are only on the landing page; elsewhere nav links point back to it. */
  anchorBase?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = `${SITE_URL}/img/og-pmi.png`,
  noindex = false,
  jsonLd = [],
  anchorBase = '',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0E1B2A" />

    <link rel="preload" href="/fonts/caladea-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-400.woff2" as="font" type="font/woff2" crossorigin />

    {
      HAS_FAVICON && (
        <>
          <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png" />
          <link rel="icon" type="image/png" sizes="192x192" href="/img/favicon-192.png" />
          <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Hubgentic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo Hubgentic e il titolo: L'AI che lavora davvero nella vostra azienda" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header anchorBase={anchorBase} />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
