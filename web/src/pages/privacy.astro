---
import Base from '../layouts/Base.astro';
import { SITE_URL } from '../data/site';
---

<Base
  title="Informativa privacy · Hubgentic"
  description="Informativa sul trattamento dei dati personali di Hubgentic."
  canonical={`${SITE_URL}/privacy`}
  anchorBase="/pmi"
  noindex
>
  <section class="container page">
    <h1>Informativa privacy</h1>
    <!-- TODO(privacy): replace this placeholder with the full informativa (GDPR art. 13) supplied by Hubgentic. -->
    <p class="todo">TODO: testo dell'informativa privacy da inserire.</p>
    <p>
      <a href="/pmi">Torna alla pagina principale</a>
    </p>
  </section>
</Base>

<style>
  .page {
    max-width: calc(760px + 2 * var(--gutter));
    padding-block: 64px 96px;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
</style>
